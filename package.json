{
  "name": "khubo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Accommodation & roommate finder platform (Iligan City). React 19 + TypeScript 5.8 + Vite 6.2. Migration history: v0.0.0 = initial scaffold from AI Studio (Staybnb rename). Dependencies: react (UI), react-router-dom (routing), @maptiler/sdk (maps), @google/genai (AI), lucide-react (icons), motion (animations), recharts (charts), date-fns (dates), clsx+tailwind-merge (styling). DevDeps: vite, tailwindcss, typescript, eslint, prettier, autoprefixer.",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@maptiler/sdk": "^4.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.76",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
}
