{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "~/.config/opencode/skills",
      "~/.config/opencode/skills/shared-claude-skills"
    ]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "rm *": "deny",
      "*": "allow"
    },
    "browser": "allow"
  }
}
